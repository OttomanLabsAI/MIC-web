/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static assets are safe to cache hard - change the filename to bust.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the printed leaflet change rarely; a week saves the re-download.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/gala/mic-gala-2026-leaflet.pdf
  Cache-Control: public, max-age=604800
/gala/mic-gala-2026-leaflet-front.png
  Cache-Control: public, max-age=604800

# HTML must stay fresh so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/gala/
  Cache-Control: public, max-age=0, must-revalidate
